{
  "name": "azenplay-custom-css",
  "version": "1.0.0",
  "description": "Custom SCSS override theme for the AzenPlay iGaming platform (azenplay.com). Compiles to a single CSS file embeddable via GitHub raw / jsDelivr CDN in the back office.",
  "private": true,
  "scripts": {
    "clean": "rimraf dist",
    "compile": "sass src/main.scss dist/azenplay-custom.css --style=expanded --no-source-map",
    "compile:min": "sass src/main.scss dist/azenplay-custom.min.css --style=compressed --no-source-map",
    "postcss": "postcss dist/azenplay-custom.css dist/azenplay-custom.min.css --replace",
    "copy:assets": "node scripts/copy-assets.mjs",
    "compile:js": "node -e \"require('fs').copyFileSync('src/js/main.js','dist/azenplay-custom.js')\"",
    "compile:js:min": "terser src/js/main.js -o dist/azenplay-custom.min.js --compress --mangle",
    "test:js": "node scripts/test-js.mjs",
    "build": "npm run clean && npm run compile && npm run compile:min && npm run postcss && npm run compile:js && npm run compile:js:min && npm run copy:assets",
    "watch": "sass --watch src/main.scss:dist/azenplay-custom.css --style=expanded --no-source-map",
    "dev": "npm run watch"
  },
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "Firefox ESR",
    "not dead"
  ],
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "jsdom": "^27.0.1",
    "postcss": "^8.4.49",
    "postcss-cli": "^11.0.0",
    "rimraf": "^6.0.1",
    "sass": "^1.83.0",
    "terser": "^5.48.0"
  }
}
